# NEXORA — Variables d'environnement
# Copiez ce fichier en .env puis renseignez les valeurs de votre projet Supabase
# (Tableau de bord Supabase > Project Settings > API)
# Utilisez UNIQUEMENT la clé publique "anon". Ne jamais mettre la clé service_role ici.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Bucket de stockage pour les images de profil et de publications
VITE_STORAGE_BUCKET_POSTS=posts-media
VITE_STORAGE_BUCKET_AVATARS=avatars
